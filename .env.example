# =============================================================================
# YEZZ monorepo — copy to .env (root) and/or per-app .env.local as needed.
# Never commit real secrets. Values below are development placeholders only.
# =============================================================================

# --- apps/api ---
DATABASE_URL=postgres://yezz:yezz@localhost:5432/yezz
REDIS_URL=redis://localhost:6379
PORT=4000
# Comma-separated. In dev, localhost / 127.0.0.1 / LAN :3000 are also allowed automatically.
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=24h
NODE_ENV=development
# Staged rollout: deploy API with log, deploy the web BFF, then switch to require.
INTERNAL_REQUEST_ENFORCEMENT=log
# Server-only, at least 32 characters. Set the same current value on the API
# and web deployments. Never expose it through a NEXT_PUBLIC_* variable.
WEB_API_SHARED_SECRET=
# API-only optional rotation value. Rotation order:
# 1) Fly current=new, previous=old; 2) Vercel current=new;
# 3) remove Fly previous after all old-signed requests have expired.
WEB_API_SHARED_SECRET_PREVIOUS=

# --- S3 / MinIO (local dev) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=yezz
S3_SECRET_KEY=yezzsecret
S3_BUCKET=yezz-media
S3_PUBLIC_URL=http://localhost:9000/yezz-media

# --- S3 / Cloudflare R2 (production — same keys, different values) ---
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=yezz-media
# S3_PUBLIC_URL=https://media.yourdomain.com

# --- Neon PostgreSQL (production) ---
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# --- apps/web ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_USE_API=true
# Optional server-only API origin used by the signed /api/backend/* route.
# Falls back to NEXT_PUBLIC_API_URL when omitted.
API_URL=http://localhost:4000
# Hostname for Next/Image (derived from S3_PUBLIC_URL at build time if unset)
# NEXT_PUBLIC_MEDIA_URL=https://media.yourdomain.com

# --- packages/db (migrate / seed) ---
# DATABASE_URL=postgres://yezz:yezz@localhost:5432/yezz

# --- seed (packages/db) ---
ADMIN_EMAIL=admin@yezz.local
ADMIN_PASSWORD=changeme

# --- durable booking / cart emails — apps/api ---
# Keep disabled until all four production values below are configured.
EMAIL_OUTBOX_WORKER_ENABLED=false
RESEND_API_KEY=
OWNER_EMAIL=congdongdong03@gmail.com
# Required when NODE_ENV=production. Configure this only after Resend verifies
# the sending domain; do not use the Gmail reply address as a Resend sender.
# EMAIL_FROM="YezYY <bookings@yezyy.com>"
EMAIL_REPLY_TO=congdongdong03@gmail.com
