{
  "name": "yezz",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @yezz/web dev",
    "dev:web": "pnpm --filter @yezz/web dev",
    "dev:api": "pnpm --filter @yezz/api dev",
    "build": "pnpm --filter @yezz/web build",
    "build:db": "pnpm --filter @yezz/db build",
    "build:api": "pnpm build:db && pnpm --filter @yezz/api build",
    "start": "pnpm --filter @yezz/web start",
    "lint": "pnpm --filter @yezz/web lint",
    "pretypecheck": "pnpm build:db",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "db:generate": "pnpm --filter @yezz/db generate",
    "db:migrate": "pnpm --filter @yezz/db migrate",
    "db:seed": "pnpm --filter @yezz/db seed",
    "pretest:api": "pnpm build:db",
    "test:api": "pnpm --filter @yezz/api test",
    "test:api:booking-db": "pnpm build:db && pnpm --filter @yezz/api test:booking-db",
    "test:api:booking-db:closure": "node apps/web/e2e/run-booking-db-closure.mjs",
    "test:rate-limits:db": "pnpm --filter @yezz/api test:rate-limits:db",
    "test:e2e": "pnpm --filter @yezz/web test:e2e",
    "test:e2e:closure": "node apps/web/e2e/run-closure.mjs",
    "test:e2e:ui": "pnpm --filter @yezz/web test:e2e:ui",
    "check:backup": "sh scripts/check-database-backup.sh",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "verify": "pnpm typecheck && pnpm test:api && pnpm lint && pnpm build:api && pnpm build",
    "verify:release": "pnpm verify && pnpm --filter @yezz/db test && pnpm --filter @yezz/web test && pnpm test:api:booking-db:closure && pnpm test:e2e:closure"
  },
  "devDependencies": {
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2"
  },
  "packageManager": "pnpm@10.12.1"
}
