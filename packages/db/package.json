{
  "name": "@yezz/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./party-policy": "./dist/party-policy.js"
  },
  "scripts": {
    "build": "tsc",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate.ts",
    "migrate:fix": "tsx src/migrate-fix.ts",
    "seed": "pnpm run seed:dev-demo",
    "seed:dev-demo": "tsx src/seed-dev-demo.ts",
    "seed:live-booking": "tsx src/seed-live-booking-catalogue.ts",
    "seed:public-catalogue": "tsx src/seed-public-catalogue.ts",
    "bootstrap:production": "tsx src/bootstrap-production.ts",
    "test": "vitest run",
    "test:integration": "YEZYY_RUN_DB_MIGRATION_TESTS=1 YEZYY_RUN_DB_CATALOGUE_TESTS=1 vitest run src/migrations/flow-closure.migration.test.ts src/migrations/live-booking.migration.test.ts src/migrations/capability-linearization.migration.test.ts src/migrations/public-catalogue.migration.test.ts src/seed-live-booking-catalogue.integration.test.ts src/seed-public-catalogue.integration.test.ts src/bootstrap-production.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.44.2",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^25.5.0",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
